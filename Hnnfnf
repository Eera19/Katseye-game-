}
function yoonchaeQuest(){
 document.getElementById("screen").innerHTML=`<div class="card panel"><span class="tag">YOONCHAE · SIDE QUEST</span><h2>THE REHEARSAL NOTE 📝</h2><p>Yoonchae is worried she will forget one transition. She asks what you would do.</p>
 ${choiceBtn("Tell her not to worry and walk away","trustChoice('Yoonchae','low','yoonchae')")}
 ${choiceBtn("Practice the transition once together","trustChoice('Yoonchae','fine','yoonchae')")}
