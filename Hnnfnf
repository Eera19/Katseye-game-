function finishShopping(){clearInterval(window.shopInterval);if(!document.getElementById("shopGrid"))return;change(1);resultScreen("SHOPPING COMPLETE 🛍️","Manon laughs as everyone shows off their picks. The mall trip is a success!","chapter6Done()")}
