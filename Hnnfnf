function stageScene(){
 document.getElementById("screen").innerHTML=`<div class="card panel"><h2>STAGE PROBLEM 🎤</h2><p>During a rehearsal, the music cuts out for a second. Everyone looks at you.</p>
 ${choiceBtn("Freeze","stagePick('freeze')")}
 ${choiceBtn("Keep dancing on count","stagePick('dance')")}
 ${choiceBtn("Laugh and signal for the restart","stagePick('signal')")}
 </div>`;
}
function stagePick(x){
 let p=0,t="";
 if(x==="freeze"){p=-2;t="The pause breaks the formation."}
 if(x==="dance"){p=2;t="You keep the count. The others follow your lead."}
