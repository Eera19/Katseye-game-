function chapter3(){
 document.getElementById("screen").innerHTML=`<div class="card panel"><span class="tag">CHAPTER 3 · THE FIRST PERFORMANCE</span><h2>THE STAGE IS YOURS 🎤</h2><p>The lights are up. Your heart is racing. The team is waiting for your cue.</p>
