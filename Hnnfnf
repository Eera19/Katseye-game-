 resultScreen("A QUIET MOMENT 💗",`${t}<br><strong>${p>=0?"+":""}${p} points${x==="ask"?" · Yoonchae Trust +1":x==="crowd"?" · Yoonchae Trust −1":""}</strong>`,"finishDay1()");
}
function finishDay1(){
 addAch("Day One Survivor");S.chapter=2;S.day=1;save();
 modal(`<button class="close" onclick="hideModal()">×</button><h2>DAY 1 COMPLETE 🌙</h2><p>You survived your first day as the seventh member.</p><div class="notice">Tomorrow, two members want to talk to you privately.</div><button class="choice" onclick="hideModal();renderMenu()">RETURN HOME 🏠</button>`);
}
function chapter2(){
 document.getElementById("screen").innerHTML=`<div class="card panel"><span class="tag">CHAPTER 2 · THE TRUST TEST</span><h2>EARN YOUR PLACE 💗</h2><p>Daniela and Yoonchae are still cautious around the new seventh member. They each have a small side quest for you.</p>
