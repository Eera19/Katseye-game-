}
function trustChoice(name,level,which){
 const vals={low:-2,fine:-1,great:1};const v=vals[level];
 change(0,which==="yoonchae"?-2:-1,name,v);
 let text=level==="great"?`You take the extra step. ${name} notices.`:level==="fine"?`You help, but keep it simple.`:`${name} is left feeling a little unsure.`;
 resultScreen(`${name.toUpperCase()} TRUST 💗`,`${text}<br><strong>${v>0?"+":""}${v} Trust with ${name}</strong>`,"afterTrust()");
