 change(p,e);
 if(x==="team"){members.forEach(m=>S.trust[m]+=1);addAch("Team Player");save()}
 resultScreen("FIRST PERFORMANCE 🎤",`${t}<br><strong>${p>=0?"+":""}${p} points · ${e} energy${x==="team"?" · Team Trust +1":""}</strong>`,"finale()");
