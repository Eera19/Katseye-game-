 </div>`;
}
function finalPick(x){
 let p=0,e=0,t="";
 if(x==="self"){p=0;e=-5;t="You stay composed, but the group connection feels a little distant."}
 if(x==="team"){p=3;e=-3;t="You sync your breath with the team and the opening lands together."}
