function shoppingChallenge(){const choices=["Oversized sweatshirt","Sweater dress","Baggy jeans","Platform boots","Heart necklace","Mini shoulder bag","Star earrings","Pink sneakers"];document.getElementById("screen").innerHTML=`<div class="card panel"><h2>🛍️ QUICK SHOPPING</h2><p>Pick 4 items before time runs out.</p><div id="shopTimer" class="notice">45s</div><div id="shopGrid">${choices.map((x,i)=>`<button class="choice" onclick="shopPick(${i})">${x}</button>`).join("")}</div><div id="picked"></div></div>`;window.shopPicked=[];window.shopLeft=45;window.shopChoices=choices;window.shopInterval=setInterval(()=>{window.shopLeft--;let t=document.getElementById("shopTimer");if(t)t.textContent=window.shopLeft+"s";if(window.shopLeft<=0){clearInterval(window.shopInterval);finishShopping()}},1000)}
