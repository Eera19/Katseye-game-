function danceChallenge(){let total=8;document.getElementById("screen").innerHTML=`<div class="card panel center"><span class="tag">QUICK DANCE CHALLENGE</span><h2>HOOTIE FROOTIE 🍓</h2><p>Tap the beat as quickly as you can!</p><div id="danceArena" style="height:220px;position:relative;background:linear-gradient(135deg,#ffd8ef,#d9c5ff);border-radius:18px;overflow:hidden"><button id="beat" style="position:absolute;border:0;border-radius:50%;width:64px;height:64px;background:#fff;font-size:28px" onclick="hitBeat()">🍓</button></div><p id="beatScore">0 / ${total}</p></div>`;window.beatHits=0;window.beatTotal=total;window.beatTimer=setInterval(spawnBeat,850);spawnBeat();setTimeout(()=>{clearInterval(window.beatTimer);if(document.getElementById("beatScore")){change(window.beatHits>=6?2:0,window.beatHits>=6?3:0);resultScreen("CHALLENGE RESULT",window.beatHits>=6?"Amazing! The challenge is going viral. 🍓✨":"The challenge is posted!","chapter5Done()")}},12000)}
function spawnBeat(){const b=document.getElementById("beat");if(!b)return;b.style.left=(8+Math.random()*76)+"%";b.style.top=(8+Math.random()*70)+"%"}
