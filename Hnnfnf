<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>KATSEYE: Dream Debut</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Arial,Helvetica,sans-serif;background:#120d24;color:#fff}
body{overflow-x:hidden}
button{font:inherit}
.app{min-height:100vh;position:relative;overflow:hidden;background:
 radial-gradient(circle at 20% 20%,rgba(255,255,255,.14),transparent 22%),
 radial-gradient(circle at 80% 10%,rgba(255,170,235,.18),transparent 24%),
 linear-gradient(155deg,#241246,#6d2d82 48%,#f08bbd 120%)}
.app:before{content:"";position:absolute;inset:0;pointer-events:none;background-image:
 radial-gradient(circle,rgba(255,255,255,.65) 1px,transparent 1.5px);
 background-size:38px 38px;opacity:.16}
.top{position:relative;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:14px 16px}
.logo{font-weight:900;letter-spacing:4px;font-size:clamp(22px,6vw,42px);text-shadow:0 4px 20px rgba(0,0,0,.3)}
.hud{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.badge{background:rgba(15,8,28,.42);border:1px solid rgba(255,255,255,.25);border-radius:999px;padding:7px 10px;font-size:12px;backdrop-filter:blur(8px)}
.navbtn{width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.14);color:#fff;font-size:30px;line-height:1;cursor:pointer}
.screen{position:relative;z-index:2;min-height:calc(100vh - 78px);padding:12px 18px 28px;display:flex;flex-direction:column;align-items:center}
.card{width:min(900px,100%);background:rgba(18,10,35,.58);border:1px solid rgba(255,255,255,.23);border-radius:28px;padding:20px;box-shadow:0 20px 60px rgba(0,0,0,.22);backdrop-filter:blur(14px)}
.center{text-align:center}
.title{font-size:clamp(32px,9vw,72px);font-weight:1000;letter-spacing:7px;margin:6px 0}
.sub{opacity:.85;margin:0 0 16px}
.bigstart{margin:12px auto 20px;padding:15px 26px;border-radius:999px;border:2px solid rgba(255,255,255,.55);background:#fff;color:#6c2b82;font-weight:1000;letter-spacing:2px;cursor:pointer;box-shadow:0 10px 30px rgba(0,0,0,.25)}
.menu{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:8px}
.menu button,.choice{border:1px solid rgba(255,255,255,.24);background:rgba(255,255,255,.10);color:#fff;border-radius:18px;padding:14px;cursor:pointer;transition:.18s}
.menu button:hover,.choice:hover{transform:translateY(-2px);background:rgba(255,255,255,.18)}
.choice{width:100%;text-align:left;margin:7px 0}
.choice .num{font-weight:900;margin-right:8px}
.choice.good{border-color:rgba(180,255,200,.7)}
.choice.bad{border-color:rgba(255,180,200,.55)}
.result{margin-top:12px;padding:13px;border-radius:16px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22)}
.members{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;width:min(900px,100%);margin:10px 0 4px}
.member{min-width:0;text-align:center}
.avatar{height:clamp(150px,30vw,260px);position:relative;border-radius:26px 26px 18px 18px;background:linear-gradient(180deg,rgba(255,255,255,.12),rgba(0,0,0,.15));overflow:hidden;border:1px solid rgba(255,255,255,.18);animation:dance 1.5s ease-in-out infinite}
.member:nth-child(2) .avatar{animation-delay:.1s}.member:nth-child(3) .avatar{animation-delay:.2s}.member:nth-child(4) .avatar{animation-delay:.3s}.member:nth-child(5) .avatar{animation-delay:.4s}.member:nth-child(6) .avatar{animation-delay:.5s}
.avatar:before{content:"";position:absolute;width:44%;height:24%;left:28%;top:14%;border-radius:50%;background:#f3c7ae;box-shadow:0 -14px 0 7px var(--hair)}
.avatar:after{content:"";position:absolute;width:64%;height:58%;left:18%;bottom:-4%;border-radius:45% 45% 18% 18%;background:var(--outfit);box-shadow:inset 0 12px 0 rgba(255,255,255,.12)}
.member:nth-child(1){--hair:#5b352e;--outfit:linear-gradient(#cba8ff,#7e4fc7)}.member:nth-child(2){--hair:#221b19;--outfit:linear-gradient(#9fd4e9,#4d8db7)}.member:nth-child(3){--hair:#3c251d;--outfit:linear-gradient(#f2b5d4,#bd6298)}.member:nth-child(4){--hair:#2c211e;--outfit:linear-gradient(#f0d99b,#b59648)}.member:nth-child(5){--hair:#3a2a24;--outfit:linear-gradient(#b8e0c1,#5d9c76)}.member:nth-child(6){--hair:#241b19;--outfit:linear-gradient(#a8c4f4,#617ab9)}
.name{font-weight:900;font-size:12px;margin-top:7px}
.danceburst{animation:burstdance .42s ease-in-out infinite!important}
@keyframes dance{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-9px) rotate(1deg)}}
@keyframes burstdance{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-18px) scale(1.04) rotate(2deg)}}
.panel{width:min(900px,100%);margin-top:10px}
.panel h2{margin:5px 0 8px;font-size:clamp(23px,6vw,38px)}
.panel h3{margin:18px 0 8px}
.back{border:0;background:rgba(255,255,255,.13);color:#fff;border-radius:999px;padding:9px 14px;cursor:pointer}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{padding:14px;border-radius:18px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.15)}
.stat strong{display:block;font-size:25px}
.progress{height:10px;border-radius:999px;background:rgba(0,0,0,.25);overflow:hidden;margin-top:7px}
.progress i{display:block;height:100%;background:linear-gradient(90deg,#ffd4ee,#fff);width:50%}
.relationships{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.rel{padding:12px;border-radius:16px;background:rgba(255,255,255,.08)}
.hearts{letter-spacing:2px}
.tag{display:inline-block;border-radius:999px;padding:5px 9px;background:rgba(255,255,255,.12);font-size:11px;margin:2px}
.lock{opacity:.5}
.notice{padding:11px 13px;border-radius:15px;background:rgba(255,255,255,.1);margin:8px 0}
.modal{position:fixed;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:18px;background:rgba(7,4,15,.66);backdrop-filter:blur(7px)}
.modal.hidden{display:none}
.modalbox{width:min(720px,100%);max-height:88vh;overflow:auto;border-radius:26px;background:#241436;border:1px solid rgba(255,255,255,.25);padding:20px;box-shadow:0 30px 80px rgba(0,0,0,.4)}
.close{float:right;border:0;background:rgba(255,255,255,.12);color:#fff;border-radius:50%;width:38px;height:38px;cursor:pointer}
.magnetArena{height:330px;position:relative;overflow:hidden;border-radius:22px;background:
 radial-gradient(circle at 30% 30%,rgba(255,255,255,.16),transparent 15%),
 linear-gradient(145deg,#4d236c,#d56aa6);border:1px solid rgba(255,255,255,.25)}
.target{position:absolute;width:62px;height:62px;border-radius:50%;border:2px solid #fff;background:rgba(255,255,255,.18);color:#fff;font-size:25px;cursor:pointer;box-shadow:0 8px 25px rgba(0,0,0,.25)}
.ending{font-size:18px;line-height:1.55}
.footer{opacity:.7;font-size:11px;text-align:center;margin-top:14px}
@media(max-width:650px){
 .members{grid-template-columns:repeat(3,1fr)}
 .avatar{height:150px}
 .menu{grid-template-columns:1fr}
 .relationships{grid-template-columns:1fr}
 .grid2{grid-template-columns:1fr}
 .logo{letter-spacing:3px}
}
.dressGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.dressItem{border:1px solid #e7d6ef;background:#fff;border-radius:12px;padding:8px 5px;min-height:62px;font-size:11px;font-weight:800;cursor:pointer}.dressItem.sel{outline:3px solid #c786ee;background:#fff3ff}.sw{display:block;width:25px;height:25px;border-radius:50%;border:1px solid #ddd;margin:0 auto 5px}.emoji{display:block;font-size:22px;height:27px}.limit{float:right;background:#f0dcff;border-radius:999px;padding:2px 7px;font-size:10px}</style>
</head>
<body>
<div class="app" id="app">
<header class="top">
  <div class="logo">KATSEYE</div>
  <div class="hud" id="hud"></div>
  <button class="navbtn" onclick="openMenu()">›</button>
</header>
<main class="screen" id="screen"></main>
<div class="modal hidden" id="modal"><div class="modalbox" id="modalbox"></div></div>
</div>

<script>
const members=["Daniela","Lara","Manon","Megan","Sophia","Yoonchae"];
const defaults={points:3,energy:100,chapter:1,day:1,trust:{Daniela:0,Lara:0,Manon:0,Megan:0,Sophia:0,Yoonchae:0},outfit:"Dream Denim",hair:0,top:0,bottom:0,dress:null,shoe:0,accessories:[],achievements:[],records:{choices:0,perfect:0,magnet:0},finished:false};
let S=load();

function load(){try{const x=JSON.parse(localStorage.getItem("katseyeDreamDebut"));return x?merge(defaults,x):merge(defaults,{});}catch(e){return merge(defaults,{})}}
function merge(a,b){return {points:b.points??a.points,energy:b.energy??a.energy,chapter:b.chapter??a.chapter,day:b.day??a.day,trust:{...a.trust,...(b.trust||{})},outfit:b.outfit??a.outfit,hair:b.hair??a.hair,top:b.top??a.top,bottom:b.bottom??a.bottom,dress:b.dress??a.dress,shoe:b.shoe??a.shoe,accessories:Array.isArray(b.accessories)?b.accessories:[],achievements:b.achievements??[],records:{...a.records,...(b.records||{})},finished:b.finished??false}}
function save(){localStorage.setItem("katseyeDreamDebut",JSON.stringify(S));syncHud()}
function syncHud(){
 document.getElementById("hud").innerHTML=
 `<span class="badge">💎 ${S.points}</span><span class="badge">⚡ ${S.energy}</span><span class="badge">💗 ${totalTrust()}</span>`;
}
function totalTrust(){return Object.values(S.trust).reduce((a,b)=>a+b,0)}
function esc(s){return s.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;")}
function addAch(a){if(!S.achievements.includes(a))S.achievements.push(a);save()}
function change(points=0,energy=0,trustName=null,trust=0){
 S.points=Math.max(0,S.points+points); S.energy=Math.max(0,Math.min(100,S.energy+energy));
 if(trustName)S.trust[trustName]=Math.max(0,S.trust[trustName]+trust);
 S.records.choices++;
 save();
}
function openMenu(){renderMenu()}
function closeMenu(){hideModal()}
function hideModal(){document.getElementById("modal").classList.add("hidden")}
function modal(html){document.getElementById("modalbox").innerHTML=html;document.getElementById("modal").classList.remove("hidden")}
function resultScreen(title,text,next){
 modal(`<button class="close" onclick="hideModal()">×</button><h2>${title}</h2><div class="result">${text}</div><button class="choice" onclick="${next};hideModal()">CONTINUE →</button>`);
}
function touchStart(){
 document.querySelectorAll(".avatar").forEach(x=>x.classList.add("danceburst"));
 setTimeout(()=>{document.querySelectorAll(".avatar").forEach(x=>x.classList.remove("danceburst"));renderMenu()},700);
}
function renderHome(){
 document.getElementById("screen").innerHTML=`
 <div class="center" style="width:100%">
   <div class="title">DREAM DEBUT</div>
   <p class="sub">Your story as KATSEYE's seventh member ✨</p>
   <div class="members">${members.map((m,i)=>`<div class="member"><div class="avatar"></div><div class="name">${m}</div></div>`).join("")}</div>
   <button class="bigstart" onclick="touchStart()">TOUCH TO START 💗</button>
   <div class="footer">A fan-made interactive game. Original stylized artwork; no official endorsement.</div>
 </div>`;
 syncHud();
}
function renderMenu(){
 document.getElementById("screen").innerHTML=`
 <div class="card center panel">
  <h2>WELCOME, SEVENTH MEMBER 💗</h2>
  <p>Choose what you want to do.</p>
  <div class="menu">
   <button onclick="play()">① PLAY 🎮</button>
   <button onclick="you()">② YOU 👗</button>
   <button onclick="rules()">③ RULES 📖</button>
  </div>
  <div class="notice">Chapter ${S.chapter} ${S.finished?"complete ✨":"ready"} · ${S.outfit}</div>
 </div>`;
 syncHud();
}
function rules(){
 document.getElementById("screen").innerHTML=`
 <div class="card panel">
 <button class="back" onclick="renderMenu()">← MENU</button>
 <h2>RULES 📖</h2>
 <p>• Be kind to every member and the crowd.</p>
 <p>• Practice starts at sharp 7.</p>
 <p>• Make choices that feel true to your character.</p>
 <p>• Keep an eye on energy — you need it for big moments.</p>
 <p>• Trust grows slowly. Daniela and Yoonchae may take time to open up.</p>
 <p>• Most importantly: enjoy the game! 🌙</p>
 </div>`;
}
function you(){
 const rel=members.map(m=>`<div class="rel"><strong>${m}</strong><div class="hearts">${"♥".repeat(Math.max(0,Math.min(5,2+Math.floor(S.trust[m]/2))))}${"♡".repeat(5-Math.max(0,Math.min(5,2+Math.floor(S.trust[m]/2))))}</div><small>Trust ${S.trust[m]}</small></div>`).join("");
 const ach=S.achievements.length?S.achievements.map(a=>`<span class="tag">🏆 ${a}</span>`).join(""):`<span class="tag">No achievements yet</span>`;
 document.getElementById("screen").innerHTML=`
 <div class="card panel">
  <button class="back" onclick="renderMenu()">← MENU</button>
  <h2>YOU 👗</h2>
  <div class="grid2">
   <div class="stat"><strong>${S.points}</strong>Points</div>
   <div class="stat"><strong>${S.energy}</strong>Energy</div>
   <div class="stat"><strong>${S.records.choices}</strong>Choices made</div>
   <div class="stat"><strong>${S.records.magnet}</strong>Crowd Magnet best</div>
  </div>
  <h3>Closet</h3>
  <button class="choice" onclick="closet()">👗 Change outfit · Current: ${esc(S.outfit)}</button>
  <h3>Member Trust</h3>
  <div class="relationships">${rel}</div>
  <h3>Achievements</h3><div>${ach}</div>
  <h3>Progress</h3>
  <div class="progress"><i style="width:${Math.min(100,(S.chapter-1)*33+(S.finished?34:12))}%"></i></div>
  <p class="sub">Chapter ${Math.min(S.chapter,7)} of 7</p>
 </div>`;
 syncHud();
}
const dressData={hair:[["Long Waves","#35242b"],["Long Straight","#211a22"],["High Ponytail","#3d2630"],["Low Ponytail","#4a2e2a"],["Half-Up","#6a4534"],["Twin Braids","#29202a"],["High Pigtails","#3f2a24"],["Short Bob","#302329"],["Curly","#563a2d"],["Messy Bun","#38252b"],["Space Buns","#4d3028"],["Side Ponytail","#69452f"],["Braided Ponytail","#2f2221"],["Claw-Clip Updo","#7a503a"],["Layered Short","#241d25"],["Pink Hair","#d87cb8"],["Purple Hair","#8b63bd"],["Blonde Hair","#d6b26c"]],tops:[["Pink Sweatshirt","#f49acb"],["Lavender Sweatshirt","#bfa4f2"],["Cloud Sweater","#f4e8f5"],["Cherry Sweater","#d96883"],["Oversized Hoodie","#8f78ba"],["Graphic Tee","#e7e2ed"],["Baby Tee","#ffd0df"],["Denim Jacket","#7395b9"],["Sparkle Stage Top","#d99fe8"],["White Concert Top","#fff"]],bottoms:[["Baggy Jeans","#7284a3"],["Wide-Leg Jeans","#91a1bb"],["Cargo Pants","#817c70"],["Black Stage Pants","#26252b"],["Denim Skirt","#7190af"],["Sparkly Skirt","#dca8e9"],["Mini Skirt","#333039"],["Comfy Shorts","#b7a1bd"]],dresses:[["Pink Sweater Dress","#f29bc6"],["Lavender Sweater Dress","#bba5ee"],["Cream Sweater Dress","#eee1d6"],["Black Sweater Dress","#302a37"],["Starry Dress","#9d79c6"],["Soft Pink Dress","#f7bfd7"]],shoes:[["White Sneakers","#fff"],["Chunky Sneakers","#ddd"],["High-Top Sneakers","#f4c5df"],["Ankle Boots","#4a3a46"],["Knee-High Boots","#3b3039"],["Platform Boots","#29232c"],["Pink Boots","#ec8fc0"],["Black Boots","#1f1c22"],["Ballet Flats","#eab9d2"],["Cute Heels","#d58db8"]],accessories:[["Heart Necklace","💗"],["Star Earrings","⭐"],["Hair Bow","🎀"],["Mini Shoulder Bag","👜"],["Headphones","🎧"],["Sunglasses","🕶️"],["Hair Clips","✨"],["Cap","🧢"],["Sparkly Bracelet","💫"],["Choker","🖤"],["Ribbon","🎀"],["Bag Charm","🧸"]]};
function closet(){
 const section=(title,key,arr)=>`<div class="dressSection"><h3>${title}</h3><div class="dressGrid">${arr.map((x,i)=>`<button class="dressItem ${S[key]===i?'sel':''}" onclick="dressPick('${key}',${i})"><span class="sw" style="background:${x[1]}"></span>${x[0]}</button>`).join("")}</div></div>`;
 const acc=`<div class="dressSection"><h3>💎 Accessories <span class="limit">${S.accessories.length}/4</span></h3><div class="dressGrid">${dressData.accessories.map((x,i)=>`<button class="dressItem ${S.accessories.includes(i)?'sel':''}" onclick="toggleAccessory(${i})"><span class="emoji">${x[1]}</span>${x[0]}</button>`).join("")}</div></div>`;
 modal(`<button class="close" onclick="hideModal()">×</button><h2>YOU • DRESS UP 👗</h2><p>Hair, sweatshirts, sweaters, sweater dresses, bottoms, boots, shoes — and <strong>maximum 4 accessories</strong>.</p>${section("💇‍♀️ Hairstyles","hair",dressData.hair)}${section("👚 Tops, Sweatshirts & Sweaters","top",dressData.tops)}${section("👖 Bottoms","bottom",dressData.bottoms)}${section("👗 Sweater Dresses & Dresses","dress",dressData.dresses)}${section("👢 Shoes & Boots","shoe",dressData.shoes)}${acc}<button class="choice" onclick="hideModal();you()">DONE ✨</button>`);
}
function dressPick(key,i){S[key]=i;save();closet()}
function toggleAccessory(i){const p=S.accessories.indexOf(i);if(p>=0)S.accessories.splice(p,1);else if(S.accessories.length<4)S.accessories.push(i);else {alert("ACCESSORY LIMIT: 4/4 💗");return}save();closet()}
function play(){
 if(S.chapter===1)chapter1(); else if(S.chapter===2)chapter2(); else if(S.chapter===3)chapter3();
 else if(S.chapter===4)chapter4(); else if(S.chapter===5)chapter5(); else if(S.chapter===6)chapter6(); else if(S.chapter===7)chapter7(); else ending();
}
function chapter1(){
 S.day=1; save();
 document.getElementById("screen").innerHTML=`
 <div class="card panel">
 <span class="tag">CHAPTER 1 · DAY 1</span>
 <h2>YOU GOT SELECTED FOR DEBUT WITH KATSEYE! 🌟</h2>
 <p>The call is real. You're officially the seventh member. Your first practice starts tomorrow at 7:00 AM.</p>
 <h3>What time do you wake up?</h3>
 ${choiceBtn("6:50 AM","wakePick('late')")}
 ${choiceBtn("6:30 AM","wakePick('early')")}
 ${choiceBtn("4:00 AM","wakePick('veryearly')")}
 ${choiceBtn("5:00 AM","wakePick('perfect')")}
 </div>`;
}
function choiceBtn(label,fn){return `<button class="choice" onclick="${fn}">${label}</button>`}
function wakePick(x){
 let p=0,e=0,t="You make a choice and get moving.";
 if(x==="late"){p=-2;t="You rush out of bed and barely have time to breathe."}
 if(x==="early"){p=-2;t="You wake very early, but the nerves make the extra time disappear."}
 if(x==="veryearly"){p=-1;t="You are awake long before sunrise. A little intense, but you are prepared."}
 if(x==="perfect"){p=2;e=5;t="You wake at 5:00, calm and ready. You even have time to stretch."}
 change(p,e); if(x==="perfect")addAch("Morning Star");
 resultScreen("MORNING ☀️",`${t}<br><strong>${p>=0?"+":""}${p} points${e?` · +${e} energy`:""}</strong>`,"outfitScene()");
}
function outfitScene(){
 document.getElementById("screen").innerHTML=`<div class="card panel"><h2>FIRST DAY FIT 👗</h2><p>You open your closet. You want to feel like yourself — but you also want to look ready for a debut.</p>
 ${choiceBtn("Huge neon look","outPick('neon')")}
 ${choiceBtn("Oversized sleepwear","outPick('sleep')")}
 ${choiceBtn("All-black rehearsal fit","outPick('black')")}
 ${choiceBtn("Coordinated denim + pastel","outPick('cool')")}
 </div>`;
}
function outPick(x){
 let p=0,t="";
 if(x==="neon"){p=-2;t="The look is fun, but it steals attention from the team."}
 if(x==="sleep"){p=-2;t="Comfort wins. Debut energy… not quite."}
 if(x==="black"){p=-1;t="Simple and safe, though a little under-styled for the moment."}
 if(x==="cool"){p=2;t="The coordinated denim-and-pastel look fits the group's energy beautifully."}
 change(p); if(x==="cool"){S.outfit="Touch Era Denim";addAch("First Fit");save()}
 resultScreen("OUTFIT CHECK ✨",`${t}<br><strong>${p>=0?"+":""}${p} points</strong>`,"breakfastScene()");
}
function breakfastScene(){
 document.getElementById("screen").innerHTML=`<div class="card panel"><h2>BREAKFAST 🍓</h2><p>Your stomach is doing backflips. You still have a full day ahead.</p>
 ${choiceBtn("Skip breakfast","meal('skip')")}
 ${choiceBtn("Grab something tiny","meal('tiny')")}
 ${choiceBtn("Balanced breakfast","meal('balanced')")}
 </div>`;
}
function meal(x){
 let e=0,p=0,t="";
 if(x==="skip"){e=-18;t="You save time, but your energy drops fast."}
 if(x==="tiny"){e=-5;t="It's enough to take the edge off."}
 if(x==="balanced"){e=12;p=1;t="You eat enough to fuel the day and still leave on time."}
 change(p,e); resultScreen("BREAKFAST 🍓",`${t}<br><strong>${p?"+1 point · ":""}${e>=0?"+":""}${e} energy</strong>`,"travelScene()");
}
function travelScene(){
 document.getElementById("screen").innerHTML=`<div class="card panel"><h2>ON THE WAY 🚗</h2><p>You have one more decision before practice.</p>
 ${choiceBtn("Scroll and lose track of time","travelPick('scroll')")}
 ${choiceBtn("Review today's plan","travelPick('plan')")}
 ${choiceBtn("Message the group: “Can't wait!”","travelPick('message')")}
 </div>`;
}
function travelPick(x){
 let p=0,t="";
 if(x==="scroll"){p=-1;t="Oops. You arrive distracted."}
 if(x==="plan"){p=2;t="You review the schedule and arrive focused."}
 if(x==="message"){p=1;t="A few members reply with little hearts."}
 change(p); resultScreen("ARRIVAL ✨",`${t}<br><strong>${p>=0?"+":""}${p} points</strong>`,"practiceScene()");
}
function practiceScene(){
 document.getElementById("screen").innerHTML=`<div class="card panel"><span class="tag">7:00 AM SHARP</span><h2>PRACTICE STARTS 🕖</h2><p>The music begins. The choreography is harder than it looked on video.</p>
 ${choiceBtn("Copy the moves immediately","practicePick('copy')")}
 ${choiceBtn("Ask for one slower run-through","practicePick('ask')")}
 ${choiceBtn("Pretend you already know it","practicePick('pretend')")}
