function magnetStart(){
 modal(`<button class="close" onclick="hideModal()">×</button><h2>CROWD MAGNET 💗</h2><p>Tap the hearts as they appear! You have 8 seconds.</p><div class="magnetArena" id="arena"></div><p id="timer">8.0</p>`);
 startMagnet();
}
let magTimer=null,magStartTime=0,magScore=0;
function startMagnet(){
 magScore=0;magStartTime=performance.now();spawnTarget();
 clearInterval(magTimer);
 magTimer=setInterval(()=>{
  const left=Math.max(0,8-(performance.now()-magStartTime)/1000);
  const el=document.getElementById("timer"); if(el)el.textContent=left.toFixed(1);
  if(left<=0){clearInterval(magTimer);finishMagnet()}
 },80);
}
function spawnTarget(){
 const a=document.getElementById("arena");if(!a)return;
 const b=document.createElement("button");b.className="target";b.textContent="💗";
 b.style.left=(Math.random()*80+8)+"%";b.style.top=(Math.random()*68+10)+"%";
 b.onclick=()=>{magScore++;b.remove();spawnTarget()};
 a.appendChild(b);
 setTimeout(()=>{if(b.isConnected)b.remove()},850);
}
function finishMagnet(){
 document.querySelectorAll(".target").forEach(x=>x.remove());
 S.records.magnet=Math.max(S.records.magnet,magScore);
 const p=magScore>=12?3:magScore>=7?2:magScore>=3?1:0;
 if(magScore>=12)addAch("Crowd Magnet");
 change(p,0); hideModal();
 resultScreen("CROWD MAGNET 💗",`You caught <strong>${magScore}</strong> hearts.<br><strong>${p>=0?"+":""}${p} points</strong>`,"breakScene()");
}
function breakScene(){
 document.getElementById("screen").innerHTML=`<div class="card panel"><h2>BREAK TIME 🌙</h2><p>One member is sitting quietly. You notice before anyone else does.</p>
 ${choiceBtn("Give them space","sadPick('space')")}
 ${choiceBtn("Ask if they're okay","sadPick('ask')")}
 ${choiceBtn("Tell everyone to cheer them up","sadPick('crowd')")}
 </div>`;
}
function sadPick(x){
 let p=0,t="",name="Yoonchae";
 if(x==="space"){p=0;t="You respect the quiet moment."}
 if(x==="ask"){p=2;t="You check in gently. Yoonchae opens up a little."}
