function finalChallenge(){let total=12;document.getElementById("screen").innerHTML=`<div class="card panel center"><span class="tag">EXTREME MODE</span><h2>FINAL PERFORMANCE ⚡</h2><p>Very fast! Tap the beat!</p><div id="finalArena" style="height:250px;position:relative;background:linear-gradient(135deg,#c8b1ff,#ffd0e9);border-radius:18px;overflow:hidden"><button id="finalBeat" style="position:absolute;border:0;border-radius:50%;width:58px;height:58px;background:#fff;font-size:24px" onclick="hitFinal()">✨</button></div><p id="finalScore">0 / ${total}</p></div>`;window.finalHits=0;window.finalTotal=total;window.finalTimer=setInterval(spawnFinal,430);spawnFinal();setTimeout(()=>{clearInterval(window.finalTimer);if(document.getElementById("finalScore")){change(window.finalHits>=9?3:window.finalHits>=6?1:0,window.finalHits>=9?5:0);finaleChapter7(window.finalHits)}},10000)}
function spawnFinal(){const b=document.getElementById("finalBeat");if(!b)return;b.style.left=(4+Math.random()*86)+"%";b.style.top=(5+Math.random()*76)+"%"}
function hitFinal(){window.finalHits++;const s=document.getElementById("finalScore");if(s)s.textContent=Math.min(window.finalHits,window.finalTotal)+" / "+window.finalTotal;spawnFinal()}
function finaleChapter7(hits){S.finished=true;S.chapter=7;addAch("Season 1 Finale");save();modal(`<button class="close" onclick="hideModal()">×</button><h2>${hits>=9?"PERFECT PERFORMANCE ✨":"FINAL PERFORMANCE COMPLETE 💗"}</h2><div class="ending">The lights explode on. All six KATSEYE members and you perform together. Manon is back for one last performance, and the crowd erupts.</div><div class="result"><strong>Manon:</strong> “Now that felt like home.” 💗</div><p>The seven of you hold hands and take your final bow.</p><button class="choice" onclick="hideModal();ending()">SEE SEASON 1 RECORDS →</button>`)}

function finale(){
 S.finished=true;S.chapter=4;save();
 let ending="";
 if(S.points>=12)ending="The crowd remembers your confidence, and the team feels ready for the next chapter.";
 else if(S.points>=6)ending="The performance has rough edges, but you keep learning and the team keeps moving with you.";
 else ending="The day is messy, but you don't give up. There is still a stage waiting for you.";
 modal(`<button class="close" onclick="hideModal()">×</button><h2>DAY 3 COMPLETE 🌟</h2><div class="ending">${ending}</div><div class="notice"><strong>Final points:</strong> ${S.points}<br><strong>Team trust:</strong> ${totalTrust()}</div><button class="choice" onclick="hideModal();ending()">SEE YOUR RECORDS →</button>`);
}
function ending(){
 const ach=S.achievements.length?S.achievements.map(a=>`<span class="tag">🏆 ${a}</span>`).join(""):"None yet";
 document.getElementById("screen").innerHTML=`<div class="card panel center"><h2>YOUR DEBUT RECORD 🌙</h2><p>You made it through all seven chapters of Season 1.</p>
 <div class="grid2"><div class="stat"><strong>${S.points}</strong>Points</div><div class="stat"><strong>${totalTrust()}</strong>Total Trust</div><div class="stat"><strong>${S.energy}</strong>Energy left</div><div class="stat"><strong>${S.records.magnet}</strong>Best Magnet</div></div>
 <h3>Achievements</h3><div>${ach}</div>
 <p class="notice">Season 1 is complete. Your progress is saved on this device.</p>
 <button class="choice" onclick="renderMenu()">RETURN TO MENU 🏠</button>
 <button class="choice" onclick="resetGame()">RESET GAME ↺</button>
